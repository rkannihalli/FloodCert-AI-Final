run = ["sh", "-c", "cd /home/runner/workspace/artifacts/flood-cert && python -m uvicorn main:app --host 0.0.0.0 --port 8000"]

modules = ["nodejs-24", "python-3.11", "python3"]

[deployment]
run = ["sh", "-c", "cd /home/runner/workspace/artifacts/flood-cert && python -m uvicorn main:app --host 0.0.0.0 --port 8000"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 8001
externalPort = 3000

[[ports]]
localPort = 8765
externalPort = 3001

[nix]
channel = "stable-25_05"

[agent]
expertMode = true
