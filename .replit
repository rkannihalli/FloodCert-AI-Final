modules = ["nodejs-24", "python-3.11", "python3"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

run = ["sh", "-c", "cd /home/runner/workspace/artifacts/flood-cert && python -m uvicorn main:app --host 0.0.0.0 --port 8000"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 80

[nix]
channel = "stable-25_05"

[agent]
expertMode = true
